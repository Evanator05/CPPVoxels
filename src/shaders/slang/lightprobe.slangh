#ifndef LIGHTPROBE_SLANGH
#define LIGHTPROBE_SLANGH

#include "voxel.slangh"

static const uint LIGHT_PROBE_WIDTH = 16u;
static const uint LIGHT_PROBE_SPACING = 4u;
static const uint LIGHT_PROBES_PER_CHUNK = 4096u;
static const uint LIGHT_PROBE_INDEX_MASK = 0xFFFu;

struct LightProbe {
    static constexpr uint32_t NORMAL_SHIFT = 0;
    static constexpr uint32_t NORMAL_MASK = 0x1Fu;
    static constexpr uint32_t ENABLED_MASK_SHIFT = 5;
    static constexpr uint32_t ENABLED_MASK = 1u << ENABLED_MASK_SHIFT;

    float red;
    float green;
    float blue;
    uint32_t flags;
    uint64_t solid;

    bool IsEnabled() { return (flags & ENABLED_MASK) != 0u; }
    uint GetNormal() { return (flags & NORMAL_MASK) >> NORMAL_SHIFT; }
    float3 GetLight() { return float3(red, green, blue); }
};

struct LightChunk {
    int3 position;
    LightProbe probes[LIGHT_PROBES_PER_CHUNK];
};

struct LightProbeAddress {
    bool valid;
    uint chunkIndex;
    uint probeIndex;
    uint globalIndex;
};

struct LightProbeManager {
    StructuredBuffer<ChunkPositionsHeader> chunkPositionsHeader;
    StructuredBuffer<uint32_t> chunkPositions;
    RWStructuredBuffer<LightChunk> lightChunks;
    RWStructuredBuffer<uint> activeProbes;

    int FloorDiv64(int x) {
        int quotient = x / 64;
        return quotient - ((x < 0 && x % 64 != 0) ? 1 : 0);
    }

    int3 GetChunkPosition(int3 position) {
        return int3(FloorDiv64(position.x),
                    FloorDiv64(position.y),
                    FloorDiv64(position.z));
    }

    LightProbeAddress GetProbeAddress(int3 position) {
        LightProbeAddress result;
        result.valid = false;
        result.chunkIndex = POINTER_EMPTY;
        result.probeIndex = 0u;
        result.globalIndex = 0u;

        ChunkPositionsHeader header = chunkPositionsHeader[0];
        int3 chunkPosition = GetChunkPosition(position);
        int3 regionPosition = chunkPosition - header.position;
        if (any(regionPosition < int3(0)) ||
            any(regionPosition >= int3(header.size)))
            return result;

        uint width = header.size.x;
        uint area = width * header.size.y;
        uint chunkPositionIndex = uint(regionPosition.x) +
            uint(regionPosition.y) * width + uint(regionPosition.z) * area;
        uint chunkIndex = chunkPositions[chunkPositionIndex];
        if (chunkIndex == POINTER_EMPTY)
            return result;

        int3 localPosition = position - chunkPosition * int(Chunk::WIDTH);
        uint3 probePosition = uint3(localPosition) >> 2u;
        uint probeIndex = probePosition.x |
            (probePosition.y << 4u) | (probePosition.z << 8u);

        result.valid = true;
        result.chunkIndex = chunkIndex;
        result.probeIndex = probeIndex;
        result.globalIndex = chunkIndex * LIGHT_PROBES_PER_CHUNK + probeIndex;
        return result;
    }

    uint GetChunkIndex(uint globalIndex) { return globalIndex >> 12u; }
    uint GetProbeIndex(uint globalIndex) {
        return globalIndex & LIGHT_PROBE_INDEX_MASK;
    }

    void SetLight(LightProbeAddress address, float3 lighting) {
        if (!address.valid)
            return;
        lightChunks[address.chunkIndex].probes[address.probeIndex].red = lighting.x;
        lightChunks[address.chunkIndex].probes[address.probeIndex].green = lighting.y;
        lightChunks[address.chunkIndex].probes[address.probeIndex].blue = lighting.z;
    }

    bool TryEnableProbe(LightProbeAddress address) {
        bool representative = true;
        uint firstIndex = WaveReadLaneFirst(address.globalIndex);
        bool firstLane = WaveIsFirstLane();
        representative = firstLane || address.globalIndex != firstIndex;
        bool inserted = false;
        if (representative) {
            uint oldFlags;
            InterlockedOr(
                lightChunks[address.chunkIndex].probes[address.probeIndex].flags,
                LightProbe::ENABLED_MASK,
                oldFlags);
            inserted = (oldFlags & LightProbe::ENABLED_MASK) == 0u;
        }
        return inserted;
    }

    void ActivateProbe(int3 position) {
        LightProbeAddress address = GetProbeAddress(position);
        if (!address.valid)
            return;
        TryEnableProbe(address);
    }

    void DeactivateProbe(int3 position) {
        LightProbeAddress address = GetProbeAddress(position);
        if (!address.valid)
            return;
        
        uint oldFlags;
        InterlockedAnd(
            lightChunks[address.chunkIndex].probes[address.probeIndex].flags,
            ~LightProbe::ENABLED_MASK,
            oldFlags);
    }

    void AddActiveProbe(uint index) {
        uint count = WaveActiveCountBits(true);
        uint offset = WavePrefixCountBits(true);
        uint baseIndex = 0u;
        if (WaveIsFirstLane())
            InterlockedAdd(activeProbes[0], count, baseIndex);
        baseIndex = WaveReadLaneFirst(baseIndex);
        activeProbes[baseIndex + offset + 1u] = index;
    }

    void CreateProbe(int3 position) {
        LightProbeAddress address = GetProbeAddress(position);
        if (!address.valid)
            return;
        TryEnableProbe(address);
        AddActiveProbe(address.globalIndex);
    }

    uint ActivateAndAddProbe(int3 position) {
        LightProbeAddress address = GetProbeAddress(position);
        if (!address.valid)
            return POINTER_EMPTY;

        bool inserted = TryEnableProbe(address);
        if (inserted)
            AddActiveProbe(address.globalIndex);
        return address.globalIndex;
    }

    uint GetActiveProbeCount() { return activeProbes[0]; }
    uint GetActiveProbeIndex(uint activeIndex) {
        return activeProbes[activeIndex + 1u];
    }

    LightProbeAddress GetAddressFromGlobalIndex(uint globalIndex) {
        LightProbeAddress result;
        result.valid = true;
        result.chunkIndex = globalIndex >> 12u;
        result.probeIndex = globalIndex & LIGHT_PROBE_INDEX_MASK;
        result.globalIndex = globalIndex;
        return result;
    }
};

uint EncodeNormal26(int3 n) {
    if (any(n < int3(-1)) || any(n > int3(1)) || all(n == int3(0)))
        return 31u;
    uint index = uint(n.x + 1) + uint(n.y + 1) * 3u + uint(n.z + 1) * 9u;
    return index > 13u ? index - 1u : index;
}

int3 DecodeNormal26(uint index) {
    if (index >= 26u)
        return int3(0);
    if (index >= 13u)
        ++index;
    return int3(int(index % 3u) - 1,
                int((index / 3u) % 3u) - 1,
                int(index / 9u) - 1);
}

#endif