#ifndef VOXEL_FACE_HASHMAP_SLANGH
#define VOXEL_FACE_HASHMAP_SLANGH

#ifndef FACE_MAP_MAX_PROBES
#define FACE_MAP_MAX_PROBES 128u
#endif

#ifndef FACE_MAP_WAVE_INDEX_APPEND
#define FACE_MAP_WAVE_INDEX_APPEND 1
#endif

static const float3 faceNormals[6] = {
    float3( 1, 0, 0),
    float3(-1, 0, 0),
    float3( 0, 1, 0),
    float3( 0,-1, 0),
    float3( 0, 0, 1),
    float3( 0, 0,-1)
};

static const uint INVALID_SLOT = 0xFFFFFFFFu;
static const uint BUSY_SLOT    = 0xFFFFFFFEu;

static const int FACE_EMPTY_COORD = (-2147483647 - 1);

static const uint FACE_CLAIM_BIT  = 0x80000000u;
static const uint FACE_CLAIM_MASK = 0x7FFFFFFFu;

struct FaceKey {
    int3 position;
    uint face;
    bool swap;
    uint frame;
};

struct FaceEntry {
    int3 position;
    uint face;

    float3 lighting;
    uint frame;
};

struct FaceReadResult {
    uint slotIndex;
    FaceEntry entry;
};

struct FaceInsertResult {
    uint slotIndex;
    bool inserted;
};

uint FaceHashFinalize(uint h) {
    h ^= h >> 16u;
    h *= 0x7FEB352Du;
    h ^= h >> 15u;
    h *= 0x846CA68Bu;
    h ^= h >> 16u;
    return h;
}

uint Hash(int3 voxelPosition, uint face) {
    uint3 p = asuint(voxelPosition);
    uint h =
        p.x * 0x8DA6B343u ^
        p.y * 0xD8163841u ^
        p.z * 0xCB1AB31Fu ^
        face * 0x165667B1u;
    return FaceHashFinalize(h);
}

uint FaceClaimTagFromHash(uint hash) {
    uint tag = FACE_CLAIM_BIT | (hash & FACE_CLAIM_MASK);
    if (tag == INVALID_SLOT || tag == BUSY_SLOT)
        tag ^= 0x20000000u;
    return tag;
}

uint FaceClaimTag(FaceKey key) {
    return FaceClaimTagFromHash(Hash(key.position, key.face));
}

bool IsFaceClaimTag(uint face) {
    return
        (face & FACE_CLAIM_BIT) != 0u &&
        face != INVALID_SLOT &&
        face != BUSY_SLOT;
}

uint FaceMapBase(bool swap, uint capacity) {
    return swap ? capacity : 0u;
}

uint GetCapacity(RWStructuredBuffer<FaceEntry> entries) {
    uint count;
    uint stride;

    entries.GetDimensions(count, stride);

    if ((count & 1u) != 0u)
        return 0u;

    return count >> 1u;
}

bool GetSwap(uint index, RWStructuredBuffer<FaceEntry> entries) {
    return index >= GetCapacity(entries);
}

bool IsEven(uint index) {
    return (index & 1u) == 0u;
}

bool FaceMapIsPowerOfTwo(uint value) {
    return value != 0u && (value & (value - 1u)) == 0u;
}

uint FaceMapInitialSlot(uint hash, uint capacity) {
    if (FaceMapIsPowerOfTwo(capacity))
        return hash & (capacity - 1u);
    return hash % capacity;
}

uint FaceMapNextSlot(uint slot, uint capacity) {
    slot++;
    if (slot == capacity)
        slot = 0u;
    return slot;
}

FaceEntry EmptyFaceEntry() {
    FaceEntry entry;
    entry.position = int3(0);
    entry.face = INVALID_SLOT;
    entry.lighting = float3(0);
    entry.frame = INVALID_SLOT;
    return entry;
}

uint GetFaceIndex(float3 normal) {
    float3 a = abs(normal);
    if (!any(a > float3(0))) return INVALID_SLOT;
    if (a.x >= a.y && a.x >= a.z) return normal.x > 0.0 ? 0u : 1u;
    if (a.y >= a.z) return normal.y > 0.0 ? 2u : 3u;
    return normal.z > 0.0 ? 4u : 5u;
}

uint AtomicReadFace(uint slot, RWStructuredBuffer<FaceEntry> entries) {
    return entries[slot].face;
}

uint AtomicReadFrame(uint slot, RWStructuredBuffer<FaceEntry> entries) {
    return entries[slot].frame;
}

FaceReadResult ReadKey(FaceKey key, RWStructuredBuffer<FaceEntry> entries) {
    FaceReadResult result;
    result.slotIndex = INVALID_SLOT;
    result.entry = EmptyFaceEntry();

    if (key.face >= 6u)
        return result;

    if (all(key.position == int3(FACE_EMPTY_COORD)))
        return result;

    uint capacity = GetCapacity(entries);

    if (capacity == 0u)
        return result;

    uint keyHash = Hash(key.position, key.face);
    uint localSlot = FaceMapInitialSlot(keyHash, capacity);
    uint base = FaceMapBase(key.swap, capacity);
    uint probeLimit = min(uint(FACE_MAP_MAX_PROBES), capacity);

    [loop]
    for (uint probe = 0u; probe < probeLimit; ++probe) {
        uint slot = base + localSlot;

        localSlot = FaceMapNextSlot(localSlot, capacity);

        uint slotFace = entries[slot].face;

        if (slotFace != key.face)
            continue;

        int3 slotPosition = entries[slot].position;

        if (!all(slotPosition == key.position))
            continue;

        result.slotIndex = slot;
        result.entry.position = slotPosition;
        result.entry.face     = slotFace;
        result.entry.lighting = entries[slot].lighting;
        result.entry.frame    = entries[slot].frame;
        return result;
    }
    return result;
}

FaceInsertResult PlaceEntry(FaceKey key, RWStructuredBuffer<FaceEntry> entries) {
    FaceInsertResult result;

    result.slotIndex = INVALID_SLOT;
    result.inserted = false;

    if (key.face >= 6u)
        return result;

    if (key.frame == INVALID_SLOT ||
        key.frame == BUSY_SLOT)
        return result;

    if (all(key.position == int3(FACE_EMPTY_COORD)))
        return result;

    uint capacity = GetCapacity(entries);

    if (capacity == 0u)
        return result;

    uint keyHash = Hash(key.position, key.face);
    uint desiredClaim = FaceClaimTagFromHash(keyHash);
    uint localSlot = FaceMapInitialSlot(keyHash, capacity);
    uint base = FaceMapBase(key.swap, capacity);

    uint probeLimit = min(uint(FACE_MAP_MAX_PROBES), capacity);

    [loop]
    for (uint probe = 0u; probe < probeLimit; ++probe) {
        uint slot = base + localSlot;
        localSlot = FaceMapNextSlot(localSlot, capacity);
        uint observedFace = entries[slot].face;
        if (IsFaceClaimTag(observedFace)) {
            if (observedFace == desiredClaim) {
                result.slotIndex = slot;
                result.inserted = false;
                return result;
            }
            continue;
        }

        uint observedFrame = entries[slot].frame;
        if (observedFrame == key.frame) {
            if (observedFace == key.face) {
                int3 observedPosition = entries[slot].position;
                if (all(observedPosition == key.position)) {
                    result.slotIndex = slot;
                    result.inserted = false;
                    return result;
                }
            }
            continue;
        }
        uint previousFace;
        InterlockedCompareExchange(entries[slot].face, observedFace, desiredClaim, previousFace);

        if (previousFace != observedFace) {
            if (previousFace == desiredClaim) {
                result.slotIndex = slot;
                result.inserted = false;
                return result;
            }
            continue;
        }

        entries[slot].position = key.position;
        entries[slot].lighting = float3(0);
        entries[slot].frame    = key.frame;
        DeviceMemoryBarrier();
        InterlockedExchange(entries[slot].face, key.face);

        result.slotIndex = slot;
        result.inserted = true;

        return result;
    }
    return result;
}

void ResetPlacedIndexList(RWStructuredBuffer<uint> placedIndices) {
    uint count;
    uint stride;
    placedIndices.GetDimensions(count, stride);

    if (count == 0u)
        return;

    placedIndices[0] = 0u;
}

uint GetPlacedIndexCount(RWStructuredBuffer<uint> placedIndices) {
    uint count;
    uint stride;
    placedIndices.GetDimensions(count, stride);

    if (count <= 1u)
        return 0u;

    return min(placedIndices[0], count - 1u);
}

uint GetPlacedIndex(uint index, RWStructuredBuffer<uint> placedIndices) {
    uint count;
    uint stride;
    placedIndices.GetDimensions(count, stride);
    uint address = index + 1u;

    if (address >= count)
        return INVALID_SLOT;

    return placedIndices[address];
}

bool AppendPlacedIndex(bool shouldAppend, uint absoluteSlot, RWStructuredBuffer<uint> placedIndices) {
    uint listCapacity;
    uint stride;
    placedIndices.GetDimensions(listCapacity, stride);

    if (listCapacity <= 1u)
        return false;


#if FACE_MAP_WAVE_INDEX_APPEND
    uint laneOffset = WavePrefixCountBits(shouldAppend);
    uint waveAppendCount = WaveActiveCountBits(shouldAppend);
    uint waveBase = 0u;
    if (WaveIsFirstLane()) {
        if (waveAppendCount != 0u) {
            InterlockedAdd(placedIndices[0], waveAppendCount, waveBase);
        }
    }

    waveBase = WaveReadLaneFirst(waveBase);

    if (!shouldAppend)
        return false;

    uint destination = 1u + waveBase + laneOffset;
    if (destination >= listCapacity)
        return false;


    placedIndices[destination] =
        absoluteSlot;

    return true;


#else

    if (!shouldAppend)
        return false;

    uint appendOffset;
    InterlockedAdd(placedIndices[0], 1u, appendOffset);

    uint destination = 1u + appendOffset;
    if (destination >= listCapacity)
        return false;

    placedIndices[destination] = absoluteSlot;

    return true;

#endif
}

FaceInsertResult PlaceEntry(FaceKey key, RWStructuredBuffer<FaceEntry> entries, RWStructuredBuffer<uint> placedIndices) {
    FaceInsertResult result = PlaceEntry(key, entries);
    AppendPlacedIndex(result.inserted, result.slotIndex, placedIndices);
    return result;
}

void SetLighting(uint absoluteSlot, float3 lighting, RWStructuredBuffer<FaceEntry> entries) {
    if (absoluteSlot == INVALID_SLOT)
        return;
    entries[absoluteSlot].lighting = lighting;
}

float3 GetLighting(uint absoluteSlot, RWStructuredBuffer<FaceEntry> entries) {
    if (absoluteSlot == INVALID_SLOT)
        return float3(0);
    return entries[absoluteSlot].lighting;
}

#endif