/*
    WARNING
    this test shader was generated by claude and is not my work
    only using ai shader for testing

    Slang port of the original GLSL compute shader.
    Bindings preserved exactly:
      set = 0, binding = 0  -> WorldInfo storage buffer (SSBO, read-only here)
      set = 1, binding = 0  -> destImage, writeonly rgba8 image2D
    Local size preserved: 16x16x1
*/

// ── GLSL-compat helpers ────────────────────────────────────────────────────
// HLSL/Slang's fmod() differs from GLSL's mod() for negative inputs
// (GLSL: x - y*floor(x/y)). These overloads restore GLSL semantics exactly.

float gmod(float x, float y)
{
    return x - y * floor(x / y);
}

float2 gmod(float2 x, float2 y)
{
    return x - y * floor(x / y);
}

// ── Resource bindings ───────────────────────────────────────────────────────

struct WorldInfo
{
    float3 pos;
};

// GLSL "buffer WorldInfo { vec3 pos; } worldInfo;" at set=0, binding=0
[[vk::binding(0, 0)]]
StructuredBuffer<WorldInfo> worldInfo;

// GLSL "layout(set = 1, binding = 0, rgba8) uniform writeonly image2D destImage;"
[[vk::binding(0, 1)]]
[format("rgba8")]
RWTexture2D<float4> destImage;

// ── Types ────────────────────────────────────────────────────────────────────

struct HitInfo
{
    float dist;
    int material;
};

HitInfo minH(HitInfo a, HitInfo b)
{
    return (a.dist < b.dist) ? a : b;
}

// ── Primitives ────────────────────────────────────────────────────────────────

float sdBox(float3 p, float3 b)
{
    float3 q = abs(p) - b;
    return length(max(q, float3(0.0, 0.0, 0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sdCylinder(float3 p, float r, float h)
{
    float2 d = abs(float2(length(p.xz), p.y)) - float2(r, h);
    return min(max(d.x, d.y), 0.0) + length(max(d, float2(0.0, 0.0)));
}

// ── Repetition ────────────────────────────────────────────────────────────────

float2 repXZ(float2 p, float s)
{
    return gmod(p + s * 0.5, float2(s, s)) - s * 0.5;
}

float rep1(float p, float s)
{
    return gmod(p + s * 0.5, s) - s * 0.5;
}

// ── Staircase: analytical SDF, no inner loop ──────────────────────────────────

float sdStairField(float3 p, float stepH, float stepD)
{
    float i = floor(p.y / stepH);
    float best = 1e9;

    for (int k = -1; k <= 1; k++)
    {
        float fi     = i + float(k);
        float treadY = fi * stepH;
        float treadX = fi * stepD;

        float3 riserP = p - float3(treadX, treadY + stepH * 0.5, 0.0);
        float riser   = sdBox(riserP, float3(stepD * 0.08, stepH * 0.5, 1.8));

        float3 treadP = p - float3(treadX + stepD * 0.5, treadY, 0.0);
        float tread   = sdBox(treadP, float3(stepD * 0.5, stepH * 0.08, 1.8));

        best = min(best, min(riser, tread));
    }

    return best;
}

// ── Scene ─────────────────────────────────────────────────────────────────────
//
// Materials:
//   1 – floor slabs        4 – ceiling vaults
//   2 – monoliths/debris   5 – pipes/cables
//   3 – staircases         6 – shaft glow pillars

HitInfo map(float3 p)
{
    HitInfo res;
    res.dist     = 1e10;
    res.material = 0;

    float fy    = rep1(p.y + 0.6, 22.0);
    float slabD = abs(fy) - 1.2;
    res = minH(res, HitInfo(slabD, 1));

    float2 qxz   = repXZ(p.xz, 28.0);
    float2 cell  = floor((p.xz + 14.0) / 28.0);
    float  mh    = 40.0 + dot(frac(cell * float2(0.317, 0.123)), float2(12.0, 10.0));
    float  monoD = sdBox(float3(qxz.x, p.y - mh * 0.5 + 5.0, qxz.y),
                         float3(3.2, mh, 3.2));
    res = minH(res, HitInfo(monoD, 2));

    float2 q2xz   = repXZ(p.xz + float2(14.0, 14.0), 28.0);
    float2 cell2  = floor(p.xz / 28.0);
    float  mh2    = 28.0 + dot(frac(cell2 * float2(0.211, 0.347)), float2(10.0, 8.0));
    float  mono2D = sdBox(float3(q2xz.x, p.y - mh2 * 0.5, q2xz.y),
                          float3(1.8, mh2, 1.8));
    res = minH(res, HitInfo(mono2D, 2));

    float2 cvxz   = repXZ(p.xz, 56.0);
    float  vaultD = sdBox(float3(cvxz.x, p.y - 38.0, cvxz.y),
                          float3(22.0, 2.5, 22.0));
    res = minH(res, HitInfo(vaultD, 4));

    float2 stxz = repXZ(p.xz + float2(6.0, 6.0), 28.0);
    float3 st   = float3(stxz.x - 5.0, p.y - 2.0, stxz.y);
    float  stD  = sdStairField(st, 1.1, 1.0);
    res = minH(res, HitInfo(stD, 3));

    float3 st2  = float3(stxz.y - 5.0, p.y - 8.0, stxz.x);
    float  stD2 = sdStairField(st2, 1.1, 1.0);
    res = minH(res, HitInfo(stD2, 3));

    float2 shxz  = repXZ(p.xz + float2(14.0, 14.0), 56.0);
    float  glowD = sdCylinder(float3(shxz.x, p.y, shxz.y), 0.22, 9000.0);
    res = minH(res, HitInfo(glowD, 6));

    float2 cbxz = repXZ(p.xz + float2(6.0, 6.0), 14.0);
    float  cD0  = sdCylinder(float3(cbxz.x - 0.22, p.y, cbxz.y), 0.06, 9000.0);
    float  cD1  = sdCylinder(float3(cbxz.x + 0.22, p.y, cbxz.y), 0.06, 9000.0);
    res = minH(res, HitInfo(min(cD0, cD1), 5));

    float2 dbxz = repXZ(p.xz + float2(7.0, 7.0), 18.0);
    float  dbPh = floor(p.y / 22.0);
    float  dbOx = frac(dbPh * 0.317) * 6.0 - 3.0;
    float  dbOz = frac(dbPh * 0.123) * 6.0 - 3.0;
    float  debD = sdBox(float3(dbxz.x - dbOx,
                               gmod(p.y + 11.0, 22.0) - 2.0,
                               dbxz.y - dbOz),
                        float3(0.6, 0.4, 0.8));
    res = minH(res, HitInfo(debD, 2));

    return res;
}

// ── Normal ────────────────────────────────────────────────────────────────────

float3 calcNormal(float3 p)
{
    const float e = 0.002;
    return normalize(float3(
        map(p + float3(e, 0, 0)).dist - map(p - float3(e, 0, 0)).dist,
        map(p + float3(0, e, 0)).dist - map(p - float3(0, e, 0)).dist,
        map(p + float3(0, 0, e)).dist - map(p - float3(0, 0, e)).dist
    ));
}

// ── Soft shadow ───────────────────────────────────────────────────────────────

float softShadow(float3 ro, float3 rd)
{
    float res = 1.0;
    float t   = 0.1;
    for (int i = 0; i < 16; i++)
    {
        float h = map(ro + rd * t).dist;
        res = min(res, 6.0 * h / t);
        t  += clamp(h, 0.05, 0.8);
        if (h < 0.001 || t > 50.0) break;
    }
    return clamp(res, 0.0, 1.0);
}

// ── Ambient occlusion ─────────────────────────────────────────────────────────

float ambientOcclusion(float3 p, float3 n)
{
    float ao     = 0.0;
    float weight = 1.0;
    for (int i = 1; i <= 4; i++)
    {
        float d          = 0.18 * float(i);
        float sampleDist = map(p + n * d).dist;
        ao     += (d - sampleDist) * weight;
        weight *= 0.5;
    }
    return clamp(1.0 - ao, 0.0, 1.0);
}

// ── Raymarcher ────────────────────────────────────────────────────────────────

float raymarch(float3 ro, float3 rd, out int material)
{
    float t  = 0.0;
    material = 0;
    for (int i = 0; i < 512; i++)
    {
        float3  p = ro + rd * t;
        HitInfo h = map(p);
        if (h.dist < 0.002)
        {
            material = h.material;
            return t;
        }
        t += h.dist;
        if (t > 500.0) break;
    }
    return -1.0;
}

// ── Hash / noise helpers ──────────────────────────────────────────────────────

// Cheap 2D hash → [0,1)
float hash21(float2 p)
{
    p = frac(p * float2(127.1, 311.7));
    p += dot(p, p + 19.19);
    return frac(p.x * p.y);
}

// Value noise (2D), 4-tap bilinear
float vnoise2(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1, 0));
    float c = hash21(i + float2(0, 1));
    float d = hash21(i + float2(1, 1));
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

// Two-octave fBm
float fbm2(float2 p)
{
    return vnoise2(p) * 0.6 + vnoise2(p * 2.7 + 5.3) * 0.3
         + vnoise2(p * 7.1 + 2.1) * 0.1;
}

// ── Main ──────────────────────────────────────────────────────────────────────

[shader("compute")]
[numthreads(16, 16, 1)]
void computeMain(uint3 gl_GlobalInvocationID : SV_DispatchThreadID)
{
    int2 pos = int2(gl_GlobalInvocationID.xy);

    uint imgW, imgH;
    destImage.GetDimensions(imgW, imgH);
    int2 imgSize = int2(imgW, imgH);

    if (pos.x >= imgSize.x || pos.y >= imgSize.y)
        return;

    float2 uv = (float2(pos) + 0.5) / float2(imgSize);
    uv = uv * 2.0 - 1.0;
    uv.x *= float(imgSize.x) / float(imgSize.y);
    uv.y *= -1.0;

    float3 ro      = worldInfo[0].pos;
    float3 target  = worldInfo[0].pos + float3(0, 0, 1);
    float3 forward = normalize(target - ro);
    float3 right   = normalize(cross(forward, float3(0, 1, 0)));
    float3 up      = cross(right, forward);
    float3 rd      = normalize(forward + uv.x * right + uv.y * up);

    int   material;
    float t = raymarch(ro, rd, material);

    float3 color;

    if (t > 0.0)
    {
        float3 p = ro + rd * t;
        float3 n = calcNormal(p);

        float3 L1   = normalize(float3(-1.0,  2.0, -0.5));
        float3 L2   = normalize(float3( 0.5, -1.0,  0.3));
        float  sh   = softShadow(p + n * 0.02, L1);
        float  diff = max(dot(n, L1), 0.0) * sh;
        float  fill = max(dot(n, L2), 0.0) * 0.08;
        float  occ  = ambientOcclusion(p, n);

        float3 base;

        if (material == 1)
        {
            // ── Polished dark basalt floor with cyan-tinged grout lines ──────
            float2 tile  = frac(p.xz * 0.25);
            float  grout = 1.0 - smoothstep(0.03, 0.06, min(tile.x, tile.y))
                               * smoothstep(0.03, 0.06, min(1.0 - tile.x, 1.0 - tile.y));
            float  grain = fbm2(p.xz * 1.4 + floor(p.xz * 0.25) * 31.7);
            float3 stone = lerp(float3(0.04, 0.045, 0.06),
                                float3(0.10, 0.11,  0.14), grain * 0.5);
            float3 groutC = lerp(stone, float3(0.02, 0.18, 0.22), grout * 0.45);
            float  fUp    = pow(max(dot(n, float3(0, 1, 0)), 0.0), 2.0);
            base = lerp(groutC, float3(0.05, 0.12, 0.20), fUp * 0.12);
        }
        else if (material == 2)
        {
            // ── Brutalist concrete with rust streaks and lichen patches ───────
            float macro = fbm2(p.xz * 0.18 + p.y * 0.07);
            float micro = vnoise2(p.xz * 3.1 + p.y * 2.3);

            float  rustMask = smoothstep(0.48, 0.72, fbm2(p.xz * 0.6 + p.y * 0.2 + 3.7));
            float3 rust     = lerp(float3(0.28, 0.14, 0.05), float3(0.45, 0.20, 0.04), micro);

            float  lichenMask = smoothstep(0.55, 0.75, fbm2(p.xz * 0.9 + 7.3))
                              * smoothstep(-0.3, 0.1, -abs(dot(n, float3(0, 1, 0))) + 0.4);
            float3 lichen     = lerp(float3(0.08, 0.15, 0.10), float3(0.12, 0.22, 0.14),
                                     vnoise2(p.xz * 5.0));

            float3 conc = lerp(float3(0.07, 0.075, 0.09),
                               float3(0.16, 0.165, 0.20), macro * 0.55);
            conc = lerp(conc, rust,   rustMask   * 0.7);
            conc = lerp(conc, lichen, lichenMask * 0.6);

            base = conc + micro * 0.012;
        }
        else if (material == 3)
        {
            // ── Stone stairs: worn edge highlight + bioluminescent crack seams ─
            float edgeGlow = 1.0 - abs(dot(n, float3(0, 1, 0)))
                                 - abs(dot(n, float3(1, 0, 0)));
            edgeGlow = clamp(edgeGlow * 4.0, 0.0, 1.0);

            float  crack  = smoothstep(0.62, 0.65,
                               fbm2(p.xz * 4.0 + p.y * 0.8));
            float3 crackC = float3(0.18, 0.04, 0.35) * crack * 1.8;

            float  wear  = fbm2(p.xz * 2.2 + p.y * 1.0);
            float3 stone = lerp(float3(0.10, 0.095, 0.115),
                                float3(0.20, 0.19,  0.22), wear * 0.4);
            stone += edgeGlow * float3(0.06, 0.06, 0.08);

            base = stone + crackC;
        }
        else if (material == 4)
        {
            // ── Vaulted ceiling: soot-darkened with amber ember spots ─────────
            float soot  = fbm2(p.xz * 0.25 + 1.3);
            float ember = smoothstep(0.70, 0.74,
                              fbm2(p.xz * 1.8 + p.y * 0.3 + 9.1));

            float3 ceilC = lerp(float3(0.02, 0.018, 0.022),
                                float3(0.06, 0.055, 0.065), soot * 0.6);
            ceilC = lerp(ceilC, float3(0.50, 0.22, 0.03), ember * 0.28);

            float vein = smoothstep(0.60, 0.62, vnoise2(p.xz * 6.0 + p.y));
            ceilC = lerp(ceilC, float3(0.30, 0.35, 0.45), vein * 0.18);

            base = ceilC;
        }
        else if (material == 5)
        {
            // ── Corroded metal pipes: tarnished copper/iron with verdigris ────
            float axial  = frac(p.y * 0.8);
            float stripe = smoothstep(0.45, 0.55, axial) * smoothstep(0.55, 0.45, axial);

            float  verdMask = smoothstep(0.52, 0.68,
                                fbm2(float2(p.y * 1.3, atan2(p.x, p.z) * 2.0 + 4.0)));
            float3 verd = lerp(float3(0.12, 0.28, 0.22), float3(0.08, 0.38, 0.30),
                               vnoise2(float2(p.y * 2.0, 0.0)));

            float3 metal = lerp(float3(0.18, 0.12, 0.08),
                                float3(0.30, 0.22, 0.14), stripe * 0.4);
            metal = lerp(metal, verd, verdMask * 0.65);

            base = metal;
        }
        else
        {
            // ── Shaft glow pillars: plasma column with iridescent shell ───────
            float plasma = sin(p.y * 0.4) * 0.5 + 0.5;
            plasma += sin(p.y * 1.1 + 1.5) * 0.25;
            plasma  = clamp(plasma, 0.0, 1.0);

            float  fres  = pow(1.0 - abs(dot(n, -rd)), 3.0);
            float3 iriA  = float3(0.05, 0.50, 0.90);
            float3 iriB  = float3(0.60, 0.10, 0.80);
            float3 iriC  = float3(0.10, 0.80, 0.55);
            float3 iriCol = lerp(lerp(iriA, iriB, fres), iriC, fres * fres);

            base = iriCol * (0.8 + plasma * 0.5);
        }

        // ── Common shading ────────────────────────────────────────────────────

        float roughness;
        if      (material == 1) roughness = 12.0;
        else if (material == 5) roughness = 48.0;
        else if (material == 6) roughness = 128.0;
        else                    roughness = 20.0;

        float specStr;
        if      (material == 1) specStr = 0.18;
        else if (material == 5) specStr = 0.12;
        else if (material == 6) specStr = 0.60;
        else                    specStr = 0.05;

        float3 hv   = normalize(L1 - rd);
        float  spec = pow(max(dot(n, hv), 0.0), roughness);
        float3 specTint = (material == 5) ? float3(0.9, 0.7, 0.5)
                        : (material == 1) ? float3(0.6, 0.8, 1.0)
                        :                    float3(0.7, 0.8, 1.0);

        color = base * (0.08 + diff + fill) * occ;
        color += spec * specStr * specTint;

        if (material == 6)
        {
            float plasma2 = sin(p.y * 0.4) * 0.5 + 0.5;
            color += base * (0.6 + plasma2 * 0.8);
        }

        if (material == 2)
        {
            float rim = 1.0 - max(dot(n, -rd), 0.0);
            color += pow(rim, 3.0) * float3(0.01, 0.03, 0.14) * 0.7;
        }

        if (material == 1)
        {
            float2 tile  = frac(p.xz * 0.25);
            float  grout = 1.0 - smoothstep(0.03, 0.06, min(tile.x, tile.y))
                               * smoothstep(0.03, 0.06, min(1.0 - tile.x, 1.0 - tile.y));
            color += float3(0.01, 0.20, 0.28) * grout * 0.18;
        }

        if (material == 4)
        {
            float ember = smoothstep(0.70, 0.74,
                              fbm2(p.xz * 1.8 + p.y * 0.3 + 9.1));
            color += float3(0.80, 0.30, 0.02) * ember * 0.20;
        }

        float fog1 = exp(-t * 0.018);
        float fog2 = exp(-t * 0.006);
        color = lerp(float3(0.01, 0.015, 0.03),
                     lerp(float3(0.02, 0.03, 0.06), color, fog2), fog1);
    }
    else
    {
        float yg = max(rd.y * 0.5 + 0.5, 0.0);
        color = lerp(float3(0.005, 0.008, 0.018),
                     float3(0.015, 0.025, 0.060), yg * yg);
    }

    color = color / (1.0 + color);
    color = pow(color, float3(0.4545, 0.4545, 0.4545));

    float2 vt = (float2(pos) + 0.5) / float2(imgSize) * 2.0 - 1.0;
    color *= clamp(1.0 - dot(vt, vt) * 0.35, 0.0, 1.0);

    destImage[pos] = float4(color, 1.0);
}
