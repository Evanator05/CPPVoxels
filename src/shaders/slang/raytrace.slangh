#include "voxel.slangh"

#define TRACE_DIRECTION_EPSILON 1e-8
#define TRACE_HUGE 1e30
#define TRACE_NODE_WIDTH 4

struct Ray {
    float3 origin;
    float3 direction;
};

struct AABB {
    int3 pos;
    uint3 size;
};

struct AABBIntersection {
    bool hit;
    float near;
    float far;
    float3 t0;
    float3 t1;
};

struct TraceResult {
    bool hit;
    int3 position;
    float depth;
    float3 normal;
    Voxel voxel;
};

struct PreparedRay {
    float3 origin;
    float3 direction;
    float3 invDirection;
    int3 step;
};

float Min3(float3 v) { return min(v.x, min(v.y, v.z)); }
float Max3(float3 v) { return max(v.x, max(v.y, v.z)); }

uint EncodeAxisMask(bool3 m) {
    return (m.x ? 1u : 0u) | (m.y ? 2u : 0u) | (m.z ? 4u : 0u);
}

bool3 DecodeAxisMask(uint m) {
    return bool3((m & 1u) != 0u, (m & 2u) != 0u, (m & 4u) != 0u);
}

uint MinAxisMask(float3 v) { return EncodeAxisMask(v <= Min3(v)); }

uint CellIndex4(int3 p) { return uint(p.x + 4*p.y + 16*p.z); }

bool IsOutsideNode(int3 p) {
    return any(p < int3(0)) || any(p >= int3(4));
}

TraceResult TraceMiss(float3 direction) {
    TraceResult r;
    r.hit = false;
    r.position = int3(0);
    r.depth = float.maxValue;
    r.normal = direction;
    r.voxel = Voxel(0);
    return r;
}

float3 TraceVoxelNearTimes(int3 position, PreparedRay ray) {
    float3 front = select(ray.step > int3(0), float3(position), float3(position + 1));
    float3 nearT = (front - ray.origin) * ray.invDirection;
    return select(ray.step == int3(0), float3(-TRACE_HUGE), nearT);
}

void TraceRefineHit(inout TraceResult hit, PreparedRay ray, float minimumDepth) {
    float3 nearT = TraceVoxelNearTimes(hit.position, ray);
    float voxelEntry = Max3(nearT);
    hit.depth = max(voxelEntry, minimumDepth);
    if (voxelEntry > 0.0 && voxelEntry >= minimumDepth) {
        hit.normal = -float3(ray.step) * float3(nearT >= voxelEntry);
    }
}

PreparedRay PrepareRay(Ray ray) {
    PreparedRay r;
    bool3 parallel = abs(ray.direction) < float3(TRACE_DIRECTION_EPSILON);
    r.origin = ray.origin;
    r.direction = select(parallel, float3(0.0), ray.direction);
    r.step = int3(sign(r.direction));
    float3 safeDirection = select(parallel, float3(1.0), r.direction);
    r.invDirection = select(parallel, float3(TRACE_HUGE), 1.0 / safeDirection);
    return r;
}

AABBIntersection IntersectAABBPrepared(PreparedRay ray, AABB aabb) {
    AABBIntersection r;
    float3 lo = float3(aabb.pos);
    float3 hi = lo + float3(aabb.size);
    bool3 parallel = ray.step == int3(0);

    bool outside = any(parallel && ((ray.origin < lo) || (ray.origin >= hi)));
    r.t0 = select(parallel, float3(-TRACE_HUGE), (lo - ray.origin) * ray.invDirection);
    r.t1 = select(parallel, float3( TRACE_HUGE), (hi - ray.origin) * ray.invDirection);
    r.near = max(Max3(min(r.t0, r.t1)), 0.0);
    r.far = Min3(max(r.t0, r.t1));
    r.hit = !outside && any(ray.step != int3(0)) && all(aabb.size > uint3(0)) && r.far >= r.near;
    return r;
}

AABBIntersection IntersectAABB(Ray ray, AABB aabb) {
    return IntersectAABBPrepared(PrepareRay(ray), aabb);
}

struct TraceNodeMasks {
    uint2 solid;
    uint2 voxel;
};

TraceNodeMasks TraceLoadMasks(uint node, StructuredBuffer<ContreeHeader> headers) {
    ContreeHeader h = headers[node];
    TraceNodeMasks m;
    m.solid = uint2(uint(h.isSolidMask), uint(h.isSolidMask >> 32));
    m.voxel = uint2(uint(h.isVoxelMask), uint(h.isVoxelMask >> 32));
    return m;
}

bool TraceMaskBit(uint2 mask, uint slot) {
    uint word = slot < 32u ? mask.x : mask.y;
    return ((word >> (slot & 31u)) & 1u) != 0u;
}

bool TraceEmptyGroup(uint2 solid, uint slot) {
    uint word = slot < 32u ? solid.x : solid.y;
    return ((word >> (slot & 0x0Au)) & 0x00330033u) == 0u;
}

uint TracePositionSlot(uint3 positionBits, uint scaleExp, uint mirrorMask) {
    uint3 c = (positionBits >> scaleExp) & uint3(3u);
    return (c.x | (c.y << 2) | (c.z << 4)) ^ mirrorMask;
}

TraceResult TraceChunkAtEntry(uint rootNode, PreparedRay ray, float3 entryPosition, float startDepth, uint entryMask, StructuredBuffer<ContreeHeader> contreeHeaders, StructuredBuffer<ContreeData> contreeData, float maxDepth = float.maxValue, int3 coordinateOffset = int3(0)) {
    TraceResult result = TraceMiss(ray.direction);
    if (!(maxDepth >= 0.0) ||
        (maxDepth < float.maxValue && !(startDepth <= maxDepth)) ||
        rootNode == POINTER_EMPTY || all(ray.step == int3(0))) return result;

    TraceNodeMasks masks = TraceLoadMasks(rootNode, contreeHeaders);
    if ((masks.solid.x | masks.solid.y) == 0u) return result;

    bool3 mirrored = ray.step > int3(0);
    uint mirrorMask = (mirrored.x ? 3u : 0u) |
                      (mirrored.y ? 12u : 0u) |
                      (mirrored.z ? 48u : 0u);

    float3 scaledEntry = entryPosition * (1.0 / 64.0);
    float3 walkOrigin = select(mirrored, 2.0 - scaledEntry, 1.0 + scaledEntry);
    walkOrigin = clamp(walkOrigin, float3(1.0), float3(2.0));
    float3 walkDirection = -abs(ray.direction) * (1.0 / 64.0);
    float3 walkInverse = -abs(ray.invDirection) * 64.0;

    float3 entryFloor = floor(entryPosition);
    int3 entryVoxel = int3(entryFloor) - int3((ray.step < int3(0)) && (entryPosition == entryFloor));
    entryVoxel = clamp(entryVoxel, int3(0), int3(63));
    uint3 mirroredVoxel = uint3(entryVoxel) ^ select(mirrored, uint3(63u), uint3(0u));
    uint3 entryLower = uint3(0x3F800000u) | (mirroredVoxel << 17u);
    uint3 positionBits = clamp(asuint(walkOrigin), entryLower, entryLower | uint3(0x0001FFFFu));

    uint node = rootNode;
    uint middleNode = rootNode;
    uint scaleExp = 21u;
    float travel = 0.0;

    [loop]
    for (uint iteration = 0u; iteration < 192u; ++iteration) {
        if (maxDepth < float.maxValue && startDepth + travel > maxDepth) {
            uint3 voxelPos = ((positionBits >> 17u) & uint3(63u)) ^
                select(mirrored, uint3(63u), uint3(0u));
            float voxelEntry = Max3(TraceVoxelNearTimes(int3(voxelPos) + coordinateOffset, ray));
            if (max(voxelEntry, startDepth) > maxDepth) break;
        }
        uint slot = TracePositionSlot(positionBits, scaleExp, mirrorMask);

        [loop]
        while (TraceMaskBit(masks.solid, slot)) {
            if (scaleExp == 17u || TraceMaskBit(masks.voxel, slot)) {
                uint3 voxelPos = (positionBits >> 17u) & uint3(63u);
                voxelPos ^= select(mirrored, uint3(63u), uint3(0u));
                float hitDepth = startDepth + travel;
                if (maxDepth < float.maxValue) {
                    hitDepth = max(startDepth,
                        Max3(TraceVoxelNearTimes(int3(voxelPos) + coordinateOffset, ray)));
                    if (!(hitDepth <= maxDepth)) return result;
                }
                uint value = contreeData[node].child_nodes[slot];
                result.hit = true;
                result.position = int3(voxelPos);
                result.depth = hitDepth;
                result.normal = -float3(ray.step) * float3(DecodeAxisMask(entryMask));
                result.voxel = Voxel(int32_t(value));
                return result;
            }

            uint nextNode = contreeData[node].child_nodes[slot];
            if (nextNode == POINTER_EMPTY) break;
            if (scaleExp == 19u) middleNode = node;
            node = nextNode;
            scaleExp -= 2u;
            masks = TraceLoadMasks(node, contreeHeaders);
            slot = TracePositionSlot(positionBits, scaleExp, mirrorMask);
        }

        uint advanceExp = scaleExp;
        if ((masks.solid.x | masks.solid.y) == 0u) {
            advanceExp += 2u;
        } else if (TraceEmptyGroup(masks.solid, slot)) {
            advanceExp += 1u;
        }

        uint3 boxBits = positionBits & uint3(0xFFFFFFFFu << advanceExp);
        float3 boxMin = asfloat(boxBits);
        float3 exits = (boxMin - walkOrigin) * walkInverse;
        exits = select(ray.step == int3(0), float3(TRACE_HUGE), exits);
        float nextTravel = Min3(exits);
        bool3 crossed = exits <= nextTravel;
        travel = max(nextTravel, travel);
        entryMask = EncodeAxisMask(crossed);

        uint tail = (1u << advanceExp) - 1u;
        uint3 upperBits = boxBits + select(crossed, uint3(0xFFFFFFFFu), uint3(tail));
        float3 nextPosition = min(walkOrigin + walkDirection * travel, asfloat(upperBits));
        uint3 nextBits = asuint(nextPosition);

        bool3 unitBoundary = (nextBits & uint3(0x0001FFFFu)) == uint3(0u);
        nextBits -= uint3(unitBoundary && (ray.step != int3(0)));
        uint3 diff = positionBits ^ nextBits;
        uint changed = diff.x | diff.y | diff.z;
        positionBits = nextBits;

        if ((changed & 0xFF800000u) != 0u) break;

        if (scaleExp < 21u && (changed & 0x00600000u) != 0u) {
            node = rootNode;
            scaleExp = 21u;
            masks = TraceLoadMasks(node, contreeHeaders);
        } else if (scaleExp < 19u && (changed & 0x00180000u) != 0u) {
            node = middleNode;
            scaleExp = 19u;
            masks = TraceLoadMasks(node, contreeHeaders);
        }
    }
    return result;
}

TraceResult TraceChunkPrepared(Chunk chunk, PreparedRay worldRay, float startDepth, bool3 entryMask, StructuredBuffer<ContreeHeader> contreeHeaders, StructuredBuffer<ContreeData> contreeData, float maxDepth = float.maxValue) {
    PreparedRay localRay = worldRay;
    localRay.origin -= float3(chunk.position) * 64.0;
    float3 entryPosition = localRay.origin + localRay.direction * startDepth;
    TraceResult result = TraceChunkAtEntry(chunk.contree_node, localRay, entryPosition, startDepth, EncodeAxisMask(entryMask), contreeHeaders, contreeData, maxDepth);
    if (result.hit) {
        TraceRefineHit(result, localRay, startDepth);
        if (maxDepth < float.maxValue && !(result.depth <= maxDepth))
            return TraceMiss(worldRay.direction);
    }
    return result;
}

TraceResult TraceChunk(Chunk chunk, Ray ray, float startDepth, bool3 entryMask, StructuredBuffer<ContreeHeader> contreeHeaders, StructuredBuffer<ContreeData> contreeData, float maxDepth = float.maxValue) {
    return TraceChunkPrepared(chunk, PrepareRay(ray), startDepth, entryMask, contreeHeaders, contreeData, maxDepth);
}

TraceResult TraceWorld(Ray ray, StructuredBuffer<ContreeHeader> contreeHeaders, StructuredBuffer<ContreeData> contreeData, StructuredBuffer<Chunk> chunks, StructuredBuffer<ChunkPositionsHeader> chunkPositionsHeader, StructuredBuffer<uint32_t> chunkPositions, float maxDepth = float.maxValue) {
    TraceResult result = TraceMiss(ray.direction);
    if (!(maxDepth >= 0.0)) return result;
    PreparedRay prepared = PrepareRay(ray);
    int3 regionPosition = chunkPositionsHeader[0].position;
    uint3 regionSizeU = chunkPositionsHeader[0].size;
    if (any(regionSizeU == uint3(0u))) return result;
    int3 regionSize = int3(regionSizeU);
    float3 regionOrigin = float3(regionPosition) * 64.0;

    AABB bounds;
    bounds.pos = regionPosition * 64;
    bounds.size = regionSizeU * 64u;
    AABBIntersection intersection = IntersectAABBPrepared(prepared, bounds);
    if (!intersection.hit || intersection.far <= intersection.near ||
        (maxDepth < float.maxValue && intersection.near > maxDepth)) return result;

    float3 entryPosition = prepared.origin + prepared.direction * intersection.near;
    float3 gridPosition = (entryPosition - regionOrigin) * (1.0 / 64.0);
    int3 cell = int3(floor(gridPosition));
    cell -= int3((prepared.step < int3(0)) && (gridPosition == float3(cell)));
    cell = clamp(cell, int3(0), regionSize - 1);

    float3 delta = abs(prepared.invDirection) * 64.0;
    float3 boundary = regionOrigin + float3(cell + int3(prepared.step > int3(0))) * 64.0;
    float3 nextBoundary = max((boundary - prepared.origin) * prepared.invDirection, float3(intersection.near));
    nextBoundary = select(prepared.step == int3(0), float3(TRACE_HUGE), nextBoundary);

    float3 slabEntry = min(intersection.t0, intersection.t1);
    uint entryMask = EncodeAxisMask(slabEntry == intersection.near);
    float entry = intersection.near;
    uint width = regionSizeU.x;
    uint area = regionSizeU.x * regionSizeU.y;
    uint maxSteps = regionSizeU.x + regionSizeU.y + regionSizeU.z;

    [loop]
    for (uint iteration = 0u; iteration < maxSteps; ++iteration) {
        if (any(cell < int3(0)) || any(cell >= regionSize) ||
            entry >= intersection.far || (maxDepth < float.maxValue && entry > maxDepth)) break;

        uint index = uint(cell.x) + uint(cell.y) * width + uint(cell.z) * area;
        uint chunkIndex = chunkPositions[index];
        if (chunkIndex != POINTER_EMPTY) {
            uint rootNode = chunks[chunkIndex].contree_node;
            int3 chunkPosition = regionPosition + cell;
            float3 localOrigin = prepared.origin - float3(chunkPosition) * 64.0;
            float3 localEntry = localOrigin + prepared.direction * entry;
            TraceResult hit = TraceChunkAtEntry(rootNode, prepared, localEntry, entry, entryMask, contreeHeaders, contreeData, maxDepth, chunkPosition * 64);
            if (hit.hit) {
                hit.position += chunkPosition * 64;
                TraceRefineHit(hit, prepared, entry);
                if (maxDepth < float.maxValue && !(hit.depth <= maxDepth)) return result;
                return hit;
            }
        }

        float nextEntry = Min3(nextBoundary);
        if (maxDepth < float.maxValue && nextEntry > maxDepth) break;
        bool3 crossed = nextBoundary <= nextEntry;
        cell += int3(crossed) * prepared.step;
        entry = nextEntry;
        entryMask = EncodeAxisMask(crossed);
        nextBoundary += float3(crossed) * delta;
    }
    return result;
}

float2 GetNDC(int2 pos, int2 size) {
    float2 uv = (float2(pos) + 0.5) / float2(size);
    float2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;
    ndc.x *= float(size.x) / float(size.y);
    return ndc;
}